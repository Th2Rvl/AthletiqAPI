# Copier en .env (jamais versionné) et renseigner les valeurs.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/athletiq
DB_USERNAME=athletiq
DB_PASSWORD=athletiq
# Clé HS256 d'au moins 256 bits, par exemple : openssl rand -base64 32
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Copier en .env (jamais versionné) et renseigner les valeurs.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/athletiq
DB_USERNAME=athletiq
DB_PASSWORD=athletiq
# Clé HS256 d'au moins 32 octets (256 bits), par exemple : openssl rand -base64 32
ATHLETIQ_JWT_SECRET=
# Premier administrateur, créé au démarrage s'il n'existe pas (mot de passe : 12 caractères minimum).
ATHLETIQ_ADMIN_EMAIL=
ATHLETIQ_ADMIN_PASSWORD=
# Profil dev uniquement : mot de passe des comptes de démonstration (DevDataSeeder).
# Laisser vide pour ne créer aucune donnée de démo. Ne jamais le renseigner en prod.
ATHLETIQ_DEV_DEMO_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
